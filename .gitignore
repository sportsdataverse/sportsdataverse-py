.vscode
requirements.txt
.github/workflows/pytest.yml
__pycache__
*/__pycache__
./__pycache__
.DS_Store
*/.DS_Store
.pytest_cache
*/.pytest_cache
*.pyc
*/*.pyc
*.pyc
docs/node_modules
build
dist
# Notebook checkpoints + scratch notebooks at unconventional locations.
# Curated tutorial notebooks under examples/notebooks/ are explicitly
# tracked via the !examples/notebooks/*.ipynb negative pattern below.
*.ipynb
.ipynb_checkpoints
./.ipynb_checkpoints
*/.ipynb_checkpoints
!examples/notebooks/*.ipynb
*.egg-info
*.sqlite

# Local-only working notes, planning docs, scratchpads, etc. Anything in
# this directory is intentionally untracked — drop drafts, in-progress
# specs, and reconciliation diff docs here.
dev/

# Local PEP 517 build outputs from `python -m build --outdir dist_check`.
dist_check/
