[35,1]]}}}],["addit",{"_index":12,"t":{"22943":{"position":[[7,10],[37,10]]}}}],["dataset",{"_index":5,"t":{"22935":{"position":[[34,7]]}}}],["endpoint",{"_index":3,"t":{"22935":{"position":[[13,8]]}}}],["function",{"_index":13,"t":{"22943":{"position":[[25,9],[48,9]]}}}],["loader",{"_index":6,"t":{"22935":{"position":[[42,7]]}}}],["ojhl",{"_index":2,"t":{"22935":{"position":[[7,5],[66,4]]},"22943":{"position":[[0,4]]}}}],["packag",{"_index":10,"t":{"22935":{"position":[[101,8]]},"22943":{"position":[[96,8]]}}}],["parser",{"_index":7,"t":{"22935":{"position":[[54,7]]}}}],["py",{"_index":1,"t":{"22935":{"position":[[4,2]]},"22943":{"position":[[65,3]]}}}],["python",{"_index":9,"t":{"22935":{"position":[[94,6]]},"22943":{"position":[[18,6],[89,6]]}}}],["refer",{"_index":4,"t":{"22935":{"position":[[22,11]]}}}],["sdv",{"_index":0,"t":{"22935":{"position":[[0,3]]},"22943":{"position":[[61,3]]}}}],["sportsdatavers",{"_index":8,"t":{"22935":{"position":[[78,15]]},"22943":{"position":[[73,15]]}}}]],"pipeline":["stemmer"]}},{"documents":[],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[],"invertedIndex":[],"pipeline":["stemmer"]}},{"documents":[{"i":22940,"t":"most_recent_ojhl_season ojhl_season_id","s":"Dates and seasons","u":"/docs/ojhl/","h":"#dates-and-seasons","p":22935},{"i":22942,"t":"Worked examples — executed notebooks rendered as pages (refreshed weekly against the live APIs): Quickstart","s":"Examples","u":"/docs/ojhl/","h":"#examples","p":22935},{"i":22944,"t":"Hand-written wrappers, loaders, and helpers in sportsdataverse.ojhl not covered by the generated API-endpoint reference above.","s":"OJHL — additional Python functions","u":"/docs/ojhl/reference/additional","h":"","p":22943},{"i":22947,"t":"build_family(league: 'str') -> 'dict[str, Any]' Return a dict of public callables for league. All callables are fully independent closures over the single league string; none share mutable state. The dict is ready to be spread into a module namespace via globals().update(...). Parameters Returns Keys are the public function names (e.g. \"ahl_schedule\").","s":"build_family","u":"/docs/ojhl/reference/additional","h":"#build_family","p":22943},{"i":22949,"t":"ojhl_game_corsi(game_id: 'int', return_as_pandas: 'bool' = False) -> 'Any' Player-level on-ice Corsi and Fenwick for a single OJHL game. Parameters Returns One row per player on ice for a shot attempt: player_id (String), corsi_for / corsi_against / corsi_for_pct, fenwick_for / fenwick_against / fenwick_for_pct, corsi_includes_missed (Boolean), toi_seconds (Int64) and corsi_for_per60 (Float64, null without time on ice). A pandas DataFrame when return_as_pandas is True.","s":"ojhl_game_corsi","u":"/docs/ojhl/reference/additional","h":"#ojhl_game_corsi","p":22943},{"i":22951,"t":"ojhl_game_shifts(game_id: 'int', return_as_pandas: 'bool' = False) -> 'Any' Parsed shift stints for a single OJHL game. Parameters Returns One row per shift: game_id and player_id (Int64), first_name, last_name, jersey_number, home (Int64, 1 = home), period, start_time / end_time / length (clock strings), start_s / end_s (Int64 seconds) and the goal_on_shift / penalty_on_shift flags. A pandas DataFrame when return_as_pandas is True.","s":"ojhl_game_shifts","u":"/docs/ojhl/reference/additional","h":"#ojhl_game_shifts","p":22943},{"i":22953,"t":"ojhl_game_summary(game_id: 'int') -> 'dict' OJHL game summary — dict of frames (game/goals/penalties/shots_by_period/three_stars). Parameters Returns game (one row: game_id, date, status, venue, attendance, both teams and scores), goals (one row per goal with the scorer, both assists and the plus / minus skaters), penalties (one row per penalty), shots_by_period (side, period, shots) and three_stars. When the league denies the summary view, the event frames are empty and game is a game_id stub row.","s":"ojhl_game_summary","u":"/docs/ojhl/reference/additional","h":"#ojhl_game_summary","p":22943},{"i":22955,"t":"ojhl_leaders(season: 'Optional[int]' = None, season_id: 'Optional[int]' = None, return_as_pandas: 'bool' = False) -> 'Any' OJHL statistical leaders for a given season. Parameters Returns One row per ranked skater (points and goals leaders): rank (Int64), player_id, name, jersey_number, position, team_id / team_name / team_code, stat_formatted and type_formatted (String), plus photo and logo URLs. A pandas DataFrame when return_as_pandas is True.","s":"ojhl_leaders","u":"/docs/ojhl/reference/additional","h":"#ojhl_leaders","p":22943},{"i":22957,"t":"ojhl_pbp(game_id: 'int', return_as_pandas: 'bool' = False) -> 'Any' OJHL play-by-play — one row per event, fully enriched. Parameters Returns One row per event (shot, goal, penalty, faceoff, hit, goalie change ...): game_id, event, team_id, period_of_game, time_of_period, rink x_coord / y_coord (Float64, raw 600×300 coordinates), the primary / second / third player and goalie ids and names, the plus / minus skaters on a goal, game metadata from the game summary, and derived shot_distance / shot_angle / scoring_chance and the on_ice_home / on_ice_away skaters from the shift feed. Player ids are Float64 here. Some leagues (USHL, MJHL) publish only goals, penalties and goalie changes, with no coordinates. A pandas DataFrame when return_as_pandas is True.","s":"ojhl_pbp","u":"/docs/ojhl/reference/additional","h":"#ojhl_pbp","p":22943},{"i":22959,"t":"ojhl_player_stats(player_id: 'int', return_as_pandas: 'bool' = False) -> 'Any' OJHL player season stats across all seasons. Parameters Returns One row per season (and team) the player played: season_id, season_name, playoff, team_id / team_name / team_code, games_played, goals, assists, points, plus_minus, penalty_minutes, power-play / short-handed / shootout splits, shots, faceoff_wins / faceoff_attempts, ice_time and stat_type (String, as the feed ships them). A pandas DataFrame when return_as_pandas is True.","s":"ojhl_player_stats","u":"/docs/ojhl/reference/additional","h":"#ojhl_player_stats","p":22943},{"i":22961,"t":"ojhl_player_toi(game_id: 'int', return_as_pandas: 'bool' = False) -> 'Any' Per-player time-on-ice totals for a single OJHL game. Parameters Returns One row per player: player_id (Int64), first_name, last_name, toi_seconds (Int64), num_shifts and avg_shift_s (Float64). A pandas DataFrame when return_as_pandas is True.","s":"ojhl_player_toi","u":"/docs/ojhl/reference/additional","h":"#ojhl_player_toi","p":22943},{"i":22963,"t":"ojhl_schedule(season: 'Optional[int]' = None, season_id: 'Optional[int]' = None, return_as_pandas: 'bool' = False) -> 'Any' OJHL schedule — one row per game of one season. Parameters Returns One row per game: game_id, game_date, game_status, home_team / home_team_id / home_score, away_team / away_team_id / away_score, venue, season_id and game_type (all String). Only the requested season's games: a regular season, its playoffs and its preseason are separate season ids, so pass season_id (from ojhl_season_id()) for the playoffs. A pandas DataFrame when return_as_pandas is True.","s":"ojhl_schedule","u":"/docs/ojhl/reference/additional","h":"#ojhl_schedule","p":22943},{"i":22965,"t":"ojhl_standings(season: 'Optional[int]' = None, season_id: 'Optional[int]' = None, return_as_pandas: 'bool' = False) -> 'Any' OJHL standings — one row per team. Parameters Returns One row per team: team, team_code, team_rank and wins (Int64), and games_played, losses, regulation_wins, non_reg_wins, non_reg_losses, points, goals_for, goals_against, games_remaining, percentage and overall_rank (String, as the feed ships them). A pandas DataFrame when return_as_pandas is True.","s":"ojhl_standings","u":"/docs/ojhl/reference/additional","h":"#ojhl_standings","p":22943},{"i":22967,"t":"ojhl_team_roster(team_id: 'int', season: 'Optional[int]' = None, season_id: 'Optional[int]' = None, return_as_pandas: 'bool' = False) -> 'Any' OJHL team roster for a given team + season. Parameters Returns One row per rostered player: player_id, person_id, names (first_name, last_name, display_name), position, tp_jersey_number, shoots / catches, height / weight, birthdate, home and birth places, rookie, veteran_status, draft_status and player_image (String, as the feed ships them). A pandas DataFrame when return_as_pandas is True.","s":"ojhl_team_roster","u":"/docs/ojhl/reference/additional","h":"#ojhl_team_roster","p":22943},{"i":22969,"t":"ojhl_teams(season: 'Optional[int]' = None, season_id: 'Optional[int]' = None, return_as_pandas: 'bool' = False) -> 'Any' OJHL teams for a given season. Parameters Returns One row per team: team_id, team_name, team_code, team_nickname, team_label, division and team_logo (String). A pandas DataFrame when return_as_pandas is True.","s":"ojhl_teams","u":"/docs/ojhl/reference/additional","h":"#ojhl_teams","p":22943},{"i":22972,"t":"most_recent_ojhl_season() -> 'int' Newest OJHL regular season as an end-year integer: the highest season_yr of a regular season that is not a one-off event, so a preseason listed first is not a default. Returns The newest regular season's END year (2026 = the 2025-26 season).","s":"most_recent_ojhl_season","u":"/docs/ojhl/reference/additional","h":"#most_recent_ojhl_season","p":22943},{"i":22974,"t":"ojhl_season_id(return_as_pandas: 'bool' = False) -> 'Any' All OJHL seasons with end-year + game-type labels. Parameters Returns One row per season: season_id (Int64), season_name, season_short, career, playoff, start_date, end_date, season_yr (Int64, the END year) and game_type_label. A pandas DataFrame when return_as_pandas is True.","s":"ojhl_season_id","u":"/docs/ojhl/reference/additional","h":"#ojhl_season_id","p":22943}],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[["t/22940",[0,3.236,1,3.236]],["t/22942",[2,3.472,3,3.472,4,0.209,5,3.472,6,3.472,7,3.472,8,3.472,9,3.472,10,3.472,11,3.472,12,3.472,13,2.758,14,3.472]],["t/22944",[13,2.795,15,2.795,16,3.519,17,3.519,18,3.519,19,3.519,20,3.519,21,3.519,22,3.519,23,3.519,24,3.519,25,3.519]],["t/22947",[4,0.16,26,2.653,27,2.653,28,