0.185,2,0.254,3,0.705,4,0.705,5,0.705,6,0.705,7,0.705,8,0.185,9,0.185,10,0.185]],["t/23205",[0,0.179,1,0.179,2,0.179,8,0.179,9,0.248,10,0.179,11,0.942,12,0.942,13,0.942]]],"invertedIndex":[["",{"_index":11,"t":{"23205":{"position":[[6,1],[36,1]]}}}],["addit",{"_index":12,"t":{"23205":{"position":[[8,10],[38,10]]}}}],["dataset",{"_index":5,"t":{"23195":{"position":[[35,7]]}}}],["endpoint",{"_index":3,"t":{"23195":{"position":[[14,8]]}}}],["function",{"_index":13,"t":{"23205":{"position":[[26,9],[49,9]]}}}],["loader",{"_index":6,"t":{"23195":{"position":[[43,7]]}}}],["packag",{"_index":10,"t":{"23195":{"position":[[103,8]]},"23205":{"position":[[97,8]]}}}],["parser",{"_index":7,"t":{"23195":{"position":[[55,7]]}}}],["py",{"_index":1,"t":{"23195":{"position":[[4,2]]},"23205":{"position":[[66,3]]}}}],["python",{"_index":9,"t":{"23195":{"position":[[96,6]]},"23205":{"position":[[19,6],[90,6]]}}}],["qmjhl",{"_index":2,"t":{"23195":{"position":[[7,6],[67,5]]},"23205":{"position":[[0,5]]}}}],["refer",{"_index":4,"t":{"23195":{"position":[[23,11]]}}}],["sdv",{"_index":0,"t":{"23195":{"position":[[0,3]]},"23205":{"position":[[62,3]]}}}],["sportsdatavers",{"_index":8,"t":{"23195":{"position":[[80,15]]},"23205":{"position":[[74,15]]}}}]],"pipeline":["stemmer"]}},{"documents":[],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[],"invertedIndex":[],"pipeline":["stemmer"]}},{"documents":[{"i":23200,"t":"most_recent_qmjhl_season qmjhl_season_id","s":"Dates and seasons","u":"/docs/qmjhl/","h":"#dates-and-seasons","p":23195},{"i":23202,"t":"Worked examples — executed notebooks rendered as pages (refreshed weekly against the live APIs): Quickstart Junior & minor hockey tutorial","s":"Examples","u":"/docs/qmjhl/","h":"#examples","p":23195},{"i":23204,"t":"Each sportsdataverse function and its equivalent in the sister R package, fastRhockey. Same-named where possible; the R column links the package's pkgdown reference.","s":"Python ↔ R parity","u":"/docs/qmjhl/","h":"#python--r-parity","p":23195},{"i":23206,"t":"Hand-written wrappers, loaders, and helpers in sportsdataverse.qmjhl not covered by the generated API-endpoint reference above.","s":"QMJHL — additional Python functions","u":"/docs/qmjhl/reference/additional","h":"","p":23205},{"i":23209,"t":"qmjhl_game_corsi(game_id: 'int', return_as_pandas: 'bool' = False) -> 'Any' Player-level on-ice Corsi and Fenwick for a single QMJHL game. Parameters Returns One row per player on ice for a shot attempt: player_id (String), corsi_for / corsi_against / corsi_for_pct, fenwick_for / fenwick_against / fenwick_for_pct, corsi_includes_missed (Boolean), toi_seconds (Int64) and corsi_for_per60 (Float64, null without time on ice). A pandas DataFrame when return_as_pandas is True.","s":"qmjhl_game_corsi","u":"/docs/qmjhl/reference/additional","h":"#qmjhl_game_corsi","p":23205},{"i":23211,"t":"qmjhl_game_shifts(game_id: 'int', return_as_pandas: 'bool' = False) -> 'Any' Parsed shift stints for a single QMJHL game. Parameters Returns One row per shift: game_id and player_id (Int64), first_name, last_name, jersey_number, home (Int64, 1 = home), period, start_time / end_time / length (clock strings), start_s / end_s (Int64 seconds) and the goal_on_shift / penalty_on_shift flags. A pandas DataFrame when return_as_pandas is True.","s":"qmjhl_game_shifts","u":"/docs/qmjhl/reference/additional","h":"#qmjhl_game_shifts","p":23205},{"i":23213,"t":"qmjhl_game_summary(game_id: 'int') -> 'dict' QMJHL game summary — dict of frames (game/goals/penalties/shots_by_period/three_stars). Parameters Returns game (one row: game_id, date, status, venue, attendance, both teams and scores), goals (one row per goal with the scorer, both assists and the plus / minus skaters), penalties (one row per penalty), shots_by_period (side, period, shots) and three_stars. When the league denies the summary view, the event frames are empty and game is a game_id stub row.","s":"qmjhl_game_summary","u":"/docs/qmjhl/reference/additional","h":"#qmjhl_game_summary","p":23205},{"i":23215,"t":"qmjhl_leaders(season: 'Optional[int]' = None, season_id: 'Optional[int]' = None, return_as_pandas: 'bool' = False) -> 'Any' QMJHL statistical leaders for a given season. Parameters Returns One row per ranked skater (points and goals leaders): rank (Int64), player_id, name, jersey_number, position, team_id / team_name / team_code, stat_formatted and type_formatted (String), plus photo and logo URLs. A pandas DataFrame when return_as_pandas is True.","s":"qmjhl_leaders","u":"/docs/qmjhl/reference/additional","h":"#qmjhl_leaders","p":23205},{"i":23217,"t":"qmjhl_pbp(game_id: 'int', return_as_pandas: 'bool' = False) -> 'Any' QMJHL play-by-play — one row per event, fully enriched. Parameters Returns One row per event (shot, goal, penalty, faceoff, hit, goalie change ...): game_id, event, team_id, period_of_game, time_of_period, rink x_coord / y_coord (Float64, raw 600×300 coordinates), the primary / second / third player and goalie ids and names, the plus / minus skaters on a goal, game metadata from the game summary, and derived shot_distance / shot_angle / scoring_chance and the on_ice_home / on_ice_away skaters from the shift feed. Player ids are Float64 here. Some leagues (USHL, MJHL) publish only goals, penalties and goalie changes, with no coordinates. A pandas DataFrame when return_as_pandas is True.","s":"qmjhl_pbp","u":"/docs/qmjhl/reference/additional","h":"#qmjhl_pbp","p":23205},{"i":23219,"t":"qmjhl_player_stats(player_id: 'int', return_as_pandas: 'bool' = False) -> 'Any' QMJHL player season stats across all seasons. Parameters Returns One row per season (and team) the player played: season_id, season_name, playoff, team_id / team_name / team_code, games_played, goals, assists, points, plus_minus, penalty_minutes, power-play / short-handed / shootout splits, shots, faceoff_wins / faceoff_attempts, ice_time and stat_type (String, as the feed ships them). A pandas DataFrame when return_as_pandas is True.","s":"qmjhl_player_stats","u":"/docs/qmjhl/reference/additional","h":"#qmjhl_player_stats","p":23205},{"i":23221,"t":"qmjhl_player_toi(game_id: 'int', return_as_pandas: 'bool' = False) -> 'Any' Per-player time-on-ice totals for a single QMJHL game. Parameters Returns One row per player: player_id (Int64), first_name, last_name, toi_seconds (Int64), num_shifts and avg_shift_s (Float64). A pandas DataFrame when return_as_pandas is True.","s":"qmjhl_player_toi","u":"/docs/qmjhl/reference/additional","h":"#qmjhl_player_toi","p":23205},{"i":23223,"t":"qmjhl_schedule(season: 'Optional[int]' = None, season_id: 'Optional[int]' = None, return_as_pandas: 'bool' = False) -> 'Any' QMJHL schedule — one row per game of one season. Parameters Returns One row per game: game_id, game_date, game_status, home_team / home_team_id / home_score, away_team / away_team_id / away_score, venue, season_id and game_type (all String). Only the requested season's games: a regular season, its playoffs and its preseason are separate season ids, so pass season_id (from qmjhl_season_id()) for the playoffs. A pandas DataFrame when return_as_pandas is True.","s":"qmjhl_schedule","u":"/docs/qmjhl/reference/additional","h":"#qmjhl_schedule","p":23205},{"i":23225,"t":"qmjhl_standings(season: 'Optional[int]' = None, season_id: 'Optional[int]' = None, return_as_pandas: 'bool' = False) -> 'Any' QMJHL standings — one row per team. Parameters Returns One row per team: team, team_code, team_rank and wins (Int64), and games_played, losses, regulation_wins, non_reg_wins, non_reg_losses, points, goals_for, goals_against, games_remaining, percentage and overall_rank (String, as the feed ships them). A pandas DataFrame when return_as_pandas is True.","s":"qmjhl_standings","u":"/docs/qmjhl/reference/additional","h":"#qmjhl_standings","p":23205},{"i":23227,"t":"qmjhl_team_roster(team_id: 'int', season: 'Optional[int]' = None, season_id: 'Optional[int]' = None, return_as_pandas: 'bool' = False) -> 'Any' QMJHL team roster for a given team + season. Parameters Returns One row per rostered player: player_id, person_id, names (first_name, last_name, display_name), position, tp_jersey_number, shoots / catches, height / weight, birthdate, home and birth places, rookie, veteran_status, draft_status and player_image (String, as the feed ships them). A pandas DataFrame when return_as_pandas is True.","s":"qmjhl_team_roster","u":"/docs/qmjhl/reference/additional","h":"#qmjhl_team_roster","p":23205},{"i":23229,"t":"qmjhl_teams(season: 'Optional[int]' = None, season_id: 'Optional[int]' = None, return_as_pandas: 'bool' = False) -> 'Any' QMJHL teams for a given season. Parameters Returns One row per team: team_id, team_name, team_code, team_nickname, team_label, division and team_logo (String). A pandas DataFrame when return_as_pandas is True.","s":"qmjhl_teams","u":"/docs/qmjhl/reference/additional","h":"#qmjhl_teams","p":23205},{"i":23232,"t":"most_recent_qmjhl_season() -> 'int' Newest QMJHL regular season as an end-year integer: the highest season_yr of a regular season that is not a one-off event, so a preseason listed first is not a default. Returns The newest regular season's END year (2026 = the 2025-26 season).","s":"most_recent_qmjhl_season","u":"/docs/qmjhl/reference/additional","h":"#most_recent_qmjhl_season","p":23205},{"i":23234,"t":"qmjhl_season_id(return_as_pandas: 'bool' = False) -> 'Any' All QMJHL seasons with end-year + game-type labels. Parameters Returns One row per season: season_id (Int64), season_name, season_short, career, playoff, start_date, end_date, season_yr (Int64, the END year) and game_type_label. A pandas DataFrame when return_as_pandas is True.","s":"qmjhl_season_id","u":"/docs/qmjhl/reference/additional","h":"#qmjhl_season_id","p":23205}],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[["t/23200",[0,3.234,1,3.234]],["t/23202",[2,3.239,3,3.239,4,0.354,5,3.239,6,3.239,7,3.239,8,3.239,9,3.239,10,3.239,11,3.239,12,3.239,13,2.573,14,3.239,15,3.239,16,3.239,17,3