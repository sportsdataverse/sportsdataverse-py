.942,13,0.942]]],"invertedIndex":[["",{"_index":11,"t":{"31630":{"position":[[4,1],[34,1]]}}}],["addit",{"_index":12,"t":{"31630":{"position":[[6,10],[36,10]]}}}],["dataset",{"_index":5,"t":{"31620":{"position":[[33,7]]}}}],["endpoint",{"_index":3,"t":{"31620":{"position":[[12,8]]}}}],["function",{"_index":13,"t":{"31630":{"position":[[24,9],[47,9]]}}}],["loader",{"_index":6,"t":{"31620":{"position":[[41,7]]}}}],["packag",{"_index":10,"t":{"31620":{"position":[[99,8]]},"31630":{"position":[[95,8]]}}}],["parser",{"_index":7,"t":{"31620":{"position":[[53,7]]}}}],["py",{"_index":1,"t":{"31620":{"position":[[4,2]]},"31630":{"position":[[64,3]]}}}],["python",{"_index":9,"t":{"31620":{"position":[[92,6]]},"31630":{"position":[[17,6],[88,6]]}}}],["refer",{"_index":4,"t":{"31620":{"position":[[21,11]]}}}],["sdv",{"_index":0,"t":{"31620":{"position":[[0,3]]},"31630":{"position":[[60,3]]}}}],["sportsdatavers",{"_index":8,"t":{"31620":{"position":[[76,15]]},"31630":{"position":[[72,15]]}}}],["whl",{"_index":2,"t":{"31620":{"position":[[7,4],[65,3]]},"31630":{"position":[[0,3]]}}}]],"pipeline":["stemmer"]}},{"documents":[],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[],"invertedIndex":[],"pipeline":["stemmer"]}},{"documents":[{"i":31625,"t":"most_recent_whl_season whl_season_id","s":"Dates and seasons","u":"/docs/whl/","h":"#dates-and-seasons","p":31620},{"i":31627,"t":"Worked examples — executed notebooks rendered as pages (refreshed weekly against the live APIs): Quickstart Junior & minor hockey tutorial","s":"Examples","u":"/docs/whl/","h":"#examples","p":31620},{"i":31629,"t":"Each sportsdataverse function and its equivalent in the sister R package, fastRhockey. Same-named where possible; the R column links the package's pkgdown reference.","s":"Python ↔ R parity","u":"/docs/whl/","h":"#python--r-parity","p":31620},{"i":31631,"t":"Hand-written wrappers, loaders, and helpers in sportsdataverse.whl not covered by the generated API-endpoint reference above.","s":"WHL — additional Python functions","u":"/docs/whl/reference/additional","h":"","p":31630},{"i":31634,"t":"whl_game_corsi(game_id: 'int', return_as_pandas: 'bool' = False) -> 'Any' Player-level on-ice Corsi and Fenwick for a single WHL game. Parameters Returns One row per player on ice for a shot attempt: player_id (String), corsi_for / corsi_against / corsi_for_pct, fenwick_for / fenwick_against / fenwick_for_pct, corsi_includes_missed (Boolean), toi_seconds (Int64) and corsi_for_per60 (Float64, null without time on ice). A pandas DataFrame when return_as_pandas is True.","s":"whl_game_corsi","u":"/docs/whl/reference/additional","h":"#whl_game_corsi","p":31630},{"i":31636,"t":"whl_game_shifts(game_id: 'int', return_as_pandas: 'bool' = False) -> 'Any' Parsed shift stints for a single WHL game. Parameters Returns One row per shift: game_id and player_id (Int64), first_name, last_name, jersey_number, home (Int64, 1 = home), period, start_time / end_time / length (clock strings), start_s / end_s (Int64 seconds) and the goal_on_shift / penalty_on_shift flags. A pandas DataFrame when return_as_pandas is True.","s":"whl_game_shifts","u":"/docs/whl/reference/additional","h":"#whl_game_shifts","p":31630},{"i":31638,"t":"whl_game_summary(game_id: 'int') -> 'dict' WHL game summary — dict of frames (game/goals/penalties/shots_by_period/three_stars). Parameters Returns game (one row: game_id, date, status, venue, attendance, both teams and scores), goals (one row per goal with the scorer, both assists and the plus / minus skaters), penalties (one row per penalty), shots_by_period (side, period, shots) and three_stars. When the league denies the summary view, the event frames are empty and game is a game_id stub row.","s":"whl_game_summary","u":"/docs/whl/reference/additional","h":"#whl_game_summary","p":31630},{"i":31640,"t":"whl_leaders(season: 'Optional[int]' = None, season_id: 'Optional[int]' = None, return_as_pandas: 'bool' = False) -> 'Any' WHL statistical leaders for a given season. Parameters Returns One row per ranked skater (points and goals leaders): rank (Int64), player_id, name, jersey_number, position, team_id / team_name / team_code, stat_formatted and type_formatted (String), plus photo and logo URLs. A pandas DataFrame when return_as_pandas is True.","s":"whl_leaders","u":"/docs/whl/reference/additional","h":"#whl_leaders","p":31630},{"i":31642,"t":"whl_pbp(game_id: 'int', return_as_pandas: 'bool' = False) -> 'Any' WHL play-by-play — one row per event, fully enriched. Parameters Returns One row per event (shot, goal, penalty, faceoff, hit, goalie change ...): game_id, event, team_id, period_of_game, time_of_period, rink x_coord / y_coord (Float64, raw 600×300 coordinates), the primary / second / third player and goalie ids and names, the plus / minus skaters on a goal, game metadata from the game summary, and derived shot_distance / shot_angle / scoring_chance and the on_ice_home / on_ice_away skaters from the shift feed. Player ids are Float64 here. Some leagues (USHL, MJHL) publish only goals, penalties and goalie changes, with no coordinates. A pandas DataFrame when return_as_pandas is True.","s":"whl_pbp","u":"/docs/whl/reference/additional","h":"#whl_pbp","p":31630},{"i":31644,"t":"whl_player_stats(player_id: 'int', return_as_pandas: 'bool' = False) -> 'Any' WHL player season stats across all seasons. Parameters Returns One row per season (and team) the player played: season_id, season_name, playoff, team_id / team_name / team_code, games_played, goals, assists, points, plus_minus, penalty_minutes, power-play / short-handed / shootout splits, shots, faceoff_wins / faceoff_attempts, ice_time and stat_type (String, as the feed ships them). A pandas DataFrame when return_as_pandas is True.","s":"whl_player_stats","u":"/docs/whl/reference/additional","h":"#whl_player_stats","p":31630},{"i":31646,"t":"whl_player_toi(game_id: 'int', return_as_pandas: 'bool' = False) -> 'Any' Per-player time-on-ice totals for a single WHL game. Parameters Returns One row per player: player_id (Int64), first_name, last_name, toi_seconds (Int64), num_shifts and avg_shift_s (Float64). A pandas DataFrame when return_as_pandas is True.","s":"whl_player_toi","u":"/docs/whl/reference/additional","h":"#whl_player_toi","p":31630},{"i":31648,"t":"whl_schedule(season: 'Optional[int]' = None, season_id: 'Optional[int]' = None, return_as_pandas: 'bool' = False) -> 'Any' WHL schedule — one row per game of one season. Parameters Returns One row per game: game_id, game_date, game_status, home_team / home_team_id / home_score, away_team / away_team_id / away_score, venue, season_id and game_type (all String). Only the requested season's games: a regular season, its playoffs and its preseason are separate season ids, so pass season_id (from whl_season_id()) for the playoffs. A pandas DataFrame when return_as_pandas is True.","s":"whl_schedule","u":"/docs/whl/reference/additional","h":"#whl_schedule","p":31630},{"i":31650,"t":"whl_standings(season: 'Optional[int]' = None, season_id: 'Optional[int]' = None, return_as_pandas: 'bool' = False) -> 'Any' WHL standings — one row per team. Parameters Returns One row per team: team, team_code, team_rank and wins (Int64), and games_played, losses, regulation_wins, non_reg_wins, non_reg_losses, points, goals_for, goals_against, games_remaining, percentage and overall_rank (String, as the feed ships them). A pandas DataFrame when return_as_pandas is True.","s":"whl_standings","u":"/docs/whl/reference/additional","h":"#whl_standings","p":31630},{"i":31652,"t":"whl_team_roster(team_id: 'int', season: 'Optional[int]' = None, season_id: 'Optional[int]' = None, return_as_pandas: 'bool' = False) -> 'Any' WHL team roster for a given team + season. Parameters Returns One row per rostered player: player_id, person_id, names (first_name, last_name, display_name), position, tp_jersey_number, shoots / catches, height / weight, birthdate, home and birth places, rookie, veteran_status, draft_status and player_image (String, as the feed ships them). A pandas DataFrame when return_as_pandas is True.","s":"whl_team_roster","u":"/docs/whl/reference/additional","h":"#whl_team_roster","p":31630},{"i":31654,"t":"whl_teams(season: 'Optional[int]' = None, season_id: 'Optional[int]' = None, return_as_pandas: 'bool' = False) -> 'Any' WHL teams for a given season. Parameters Returns One row per team: team_id, team_name, team_code, team_nickname, team_label, division and team_logo (String). A pandas DataFrame when return_as_pandas is True.","s":"whl_teams","u":"/docs/whl/reference/additional","h":"#whl_teams","p":31630},{"i":31657,"t":"most_recent_whl_season() -> 'int' Newest WHL regular season as an end-year integer: the highest season_yr of a regular season that is not a one-off event, so a preseason listed first is not a default. Returns The newest regular season's END year (2026 = the 2025-26 season).","s":"most_recent_whl_season","u":"/docs/whl/reference/additional","h":"#most_recent_whl_season","p":31630},{"i":31659,"t":"whl_season_id(return_as_pandas: 'bool' = False) -> 'Any' All WHL seasons with end-year + game-type labels. Parameters Returns One row per season: season_id (Int64), season_name, season_short, career, playoff, start_date, end_date, season_yr (Int64, the END year) and game_type_label. A pandas DataFrame when return_as_pandas is True.","s":"whl_season_id","u":"/docs/whl/reference/additional","h":"#whl_season_id","p":31630}],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[["t/31625",[0,3.234,1,3.234]],["t/31627",[2,3.239,3,3.239,4,0.354,5,3.239,6,3.239,7,3.239,8,3.239,9,3.239,10,3.239,11,3.239,12,3.239,13,2.573,14,3.239,15,3.239,16,3.239,17,3.239,18,3.239]],["t/31629",[19,3.281,20,3.281,21,3.281,22,3.281,23,3.281,24,4.101,25,3.281,26,3.281,27,3.281,28,1.83,29,3.281,30,3.281,31,3.281,32,3.281,33,3.281,34,2.606]],["t/31631",[13,2.786,34,2.786,35,2.786,36,3.508,37,3.508,38,3.508,39,3.508,40,3.508,41,3.508,42,3.508,43,3.508,44,3.508]],["t/31634",