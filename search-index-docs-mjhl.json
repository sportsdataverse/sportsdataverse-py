21":{"position":[[5,1],[35,1]]}}}],["addit",{"_index":12,"t":{"19221":{"position":[[7,10],[37,10]]}}}],["dataset",{"_index":5,"t":{"19213":{"position":[[34,7]]}}}],["endpoint",{"_index":3,"t":{"19213":{"position":[[13,8]]}}}],["function",{"_index":13,"t":{"19221":{"position":[[25,9],[48,9]]}}}],["loader",{"_index":6,"t":{"19213":{"position":[[42,7]]}}}],["mjhl",{"_index":2,"t":{"19213":{"position":[[7,5],[66,4]]},"19221":{"position":[[0,4]]}}}],["packag",{"_index":10,"t":{"19213":{"position":[[101,8]]},"19221":{"position":[[96,8]]}}}],["parser",{"_index":7,"t":{"19213":{"position":[[54,7]]}}}],["py",{"_index":1,"t":{"19213":{"position":[[4,2]]},"19221":{"position":[[65,3]]}}}],["python",{"_index":9,"t":{"19213":{"position":[[94,6]]},"19221":{"position":[[18,6],[89,6]]}}}],["refer",{"_index":4,"t":{"19213":{"position":[[22,11]]}}}],["sdv",{"_index":0,"t":{"19213":{"position":[[0,3]]},"19221":{"position":[[61,3]]}}}],["sportsdatavers",{"_index":8,"t":{"19213":{"position":[[78,15]]},"19221":{"position":[[73,15]]}}}]],"pipeline":["stemmer"]}},{"documents":[],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[],"invertedIndex":[],"pipeline":["stemmer"]}},{"documents":[{"i":19218,"t":"mjhl_season_id most_recent_mjhl_season","s":"Dates and seasons","u":"/docs/mjhl/","h":"#dates-and-seasons","p":19213},{"i":19220,"t":"Worked examples — executed notebooks rendered as pages (refreshed weekly against the live APIs): Quickstart","s":"Examples","u":"/docs/mjhl/","h":"#examples","p":19213},{"i":19222,"t":"Hand-written wrappers, loaders, and helpers in sportsdataverse.hockey.mjhl that are not generated API-endpoint wrappers (those have their own reference pages).","s":"MJHL — additional Python functions","u":"/docs/mjhl/reference/additional","h":"","p":19221},{"i":19225,"t":"build_family(league: 'str') -> 'dict[str, Any]' Return a dict of public callables for league. All callables are fully independent closures over the single league string; none share mutable state. The dict is ready to be spread into a module namespace via globals().update(...). Parameters Returns Keys are the public function names (e.g. \"ahl_schedule\").","s":"build_family","u":"/docs/mjhl/reference/additional","h":"#build_family","p":19221},{"i":19227,"t":"mjhl_game_corsi(game_id: 'int', return_as_pandas: 'bool' = False) -> 'Any' Player-level on-ice Corsi and Fenwick for a single MJHL game. Parameters Returns One row per player on ice for a shot attempt: player_id (String), corsi_for / corsi_against / corsi_for_pct, fenwick_for / fenwick_against / fenwick_for_pct, corsi_includes_missed (Boolean), toi_seconds (Int64) and corsi_for_per60 (Float64, null without time on ice). A pandas DataFrame when return_as_pandas is True. Raises","s":"mjhl_game_corsi","u":"/docs/mjhl/reference/additional","h":"#mjhl_game_corsi","p":19221},{"i":19229,"t":"mjhl_game_shifts(game_id: 'int', return_as_pandas: 'bool' = False) -> 'Any' Parsed shift stints for a single MJHL game. Parameters Returns One row per shift: game_id and player_id (Int64), first_name, last_name, jersey_number, home (Int64, 1 = home), period, start_time / end_time / length (clock strings), start_s / end_s (Int64 seconds) and the goal_on_shift / penalty_on_shift flags. A pandas DataFrame when return_as_pandas is True. Raises","s":"mjhl_game_shifts","u":"/docs/mjhl/reference/additional","h":"#mjhl_game_shifts","p":19221},{"i":19231,"t":"mjhl_game_summary(game_id: 'int') -> 'dict' MJHL game summary — dict of frames (game/goals/penalties/shots_by_period/three_stars). Parameters Returns game (one row: game_id, date, status, venue, attendance, both teams and scores), goals (one row per goal with the scorer, both assists and the plus / minus skaters), penalties (one row per penalty), shots_by_period (side, period, shots) and three_stars. When the league denies the summary view, the event frames are empty and game is a game_id stub row. Raises","s":"mjhl_game_summary","u":"/docs/mjhl/reference/additional","h":"#mjhl_game_summary","p":19221},{"i":19233,"t":"mjhl_leaders(season: 'Optional[int]' = None, season_id: 'Optional[int]' = None, return_as_pandas: 'bool' = False) -> 'Any' MJHL statistical leaders for a given season. Parameters Returns One row per ranked skater (points and goals leaders): rank (Int64), player_id, name, jersey_number, position, team_id / team_name / team_code, stat_formatted and type_formatted (String), plus photo and logo URLs. A pandas DataFrame when return_as_pandas is True. Raises","s":"mjhl_leaders","u":"/docs/mjhl/reference/additional","h":"#mjhl_leaders","p":19221},{"i":19235,"t":"mjhl_pbp(game_id: 'int', return_as_pandas: 'bool' = False) -> 'Any' MJHL play-by-play — one row per event, fully enriched. Parameters Returns One row per event (shot, goal, penalty, faceoff, hit, goalie change ...): game_id, event, team_id, period_of_game, time_of_period, rink x_coord / y_coord (Float64, raw 600×300 coordinates), the primary / second / third player and goalie ids and names, the plus / minus skaters on a goal, game metadata from the game summary, and derived shot_distance / shot_angle / scoring_chance and the on_ice_home / on_ice_away skaters from the shift feed. Player ids are Float64 here. Some leagues (USHL, MJHL) publish only goals, penalties and goalie changes, with no coordinates. A pandas DataFrame when return_as_pandas is True. Raises","s":"mjhl_pbp","u":"/docs/mjhl/reference/additional","h":"#mjhl_pbp","p":19221},{"i":19237,"t":"mjhl_player_stats(player_id: 'int', return_as_pandas: 'bool' = False) -> 'Any' MJHL player season stats across all seasons. Parameters Returns One row per season (and team) the player played: season_id, season_name, playoff, team_id / team_name / team_code, games_played, goals, assists, points, plus_minus, penalty_minutes, power-play / short-handed / shootout splits, shots, faceoff_wins / faceoff_attempts, ice_time and stat_type (String, as the feed ships them). A pandas DataFrame when return_as_pandas is True. Raises","s":"mjhl_player_stats","u":"/docs/mjhl/reference/additional","h":"#mjhl_player_stats","p":19221},{"i":19239,"t":"mjhl_player_toi(game_id: 'int', return_as_pandas: 'bool' = False) -> 'Any' Per-player time-on-ice totals for a single MJHL game. Parameters Returns One row per player: player_id (Int64), first_name, last_name, toi_seconds (Int64), num_shifts and avg_shift_s (Float64). A pandas DataFrame when return_as_pandas is True. Raises","s":"mjhl_player_toi","u":"/docs/mjhl/reference/additional","h":"#mjhl_player_toi","p":19221},{"i":19241,"t":"mjhl_schedule(season: 'Optional[int]' = None, season_id: 'Optional[int]' = None, return_as_pandas: 'bool' = False) -> 'Any' MJHL schedule — one row per game of one season. Parameters Returns One row per game: game_id, game_date, game_status, home_team / home_team_id / home_score, away_team / away_team_id / away_score, venue, season_id and game_type (all String). Only the requested season's games: a regular season, its playoffs and its preseason are separate season ids, so pass season_id (from mjhl_season_id()) for the playoffs. A pandas DataFrame when return_as_pandas is True. Raises","s":"mjhl_schedule","u":"/docs/mjhl/reference/additional","h":"#mjhl_schedule","p":19221},{"i":19243,"t":"mjhl_standings(season: 'Optional[int]' = None, season_id: 'Optional[int]' = None, return_as_pandas: 'bool' = False) -> 'Any' MJHL standings — one row per team. Parameters Returns One row per team: team, team_code, team_rank and wins (Int64), and games_played, losses, regulation_wins, non_reg_wins, non_reg_losses, points, goals_for, goals_against, games_remaining, percentage and overall_rank (String, as the feed ships them). A pandas DataFrame when return_as_pandas is True. Raises","s":"mjhl_standings","u":"/docs/mjhl/reference/additional","h":"#mjhl_standings","p":19221},{"i":19245,"t":"mjhl_team_roster(team_id: 'int', season: 'Optional[int]' = None, season_id: 'Optional[int]' = None, return_as_pandas: 'bool' = False) -> 'Any' MJHL team roster for a given team + season. Parameters Returns One row per rostered player: player_id, person_id, names (first_name, last_name, display_name), position, tp_jersey_number, shoots / catches, height / weight, birthdate, home and birth places, rookie, veteran_status, draft_status and player_image (String, as the feed ships them). A pandas DataFrame when return_as_pandas is True. Raises","s":"mjhl_team_roster","u":"/docs/mjhl/reference/additional","h":"#mjhl_team_roster","p":19221},{"i":19247,"t":"mjhl_teams(season: 'Optional[int]' = None, season_id: 'Optional[int]' = None, return_as_pandas: 'bool' = False) -> 'Any' MJHL teams for a given season. Parameters Returns One row per team: team_id, team_name, team_code, team_nickname, team_label, division and team_logo (String). A pandas DataFrame when return_as_pandas is True. Raises","s":"mjhl_teams","u":"/docs/mjhl/reference/additional","h":"#mjhl_teams","p":19221},{"i":19250,"t":"mjhl_season_id(return_as_pandas: 'bool' = False) -> 'Any' All MJHL seasons with end-year + game-type labels. Parameters Returns One row per season: season_id (Int64), season_name, season_short, career, playoff, start_date, end_date, season_yr (Int64, the END year) and game_type_label. A pandas DataFrame when return_as_pandas is True. Raises","s":"mjhl_season_id","u":"/docs/mjhl/reference/additional","h":"#mjhl_season_id","p":19221},{"i":19252,"t":"most_recent_mjhl_season() -> 'int' Newest MJHL regular season as an end-year integer: the highest season_yr of a regular season that is not a one-off event, so a preseason listed first is not a default. Returns The newest regular season's END year (2026 = the 2025-26 season). Raises","s":"most_recent_mjhl_season","u":"/docs/mjhl/reference/additional","h":"#most_recent_mjhl_season","p":19221}],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[["t/19218",[0,3.237,1,3.237]],["t/19220",[2,3.483,3,3.483,4,0.21,5,3.483,6,3.483,7,3.483,8,2.767,9,3.483,10,3.483,11,3.483,12,3.483,13,2.767,14,3.483]],["t/19222",[8,2.