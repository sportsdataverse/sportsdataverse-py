on":[[6,10],[36,10]]}}}],["dataset",{"_index":5,"t":{"19173":{"position":[[33,7]]}}}],["endpoint",{"_index":3,"t":{"19173":{"position":[[12,8]]}}}],["function",{"_index":13,"t":{"19181":{"position":[[24,9],[47,9]]}}}],["loader",{"_index":6,"t":{"19173":{"position":[[41,7]]}}}],["mhl",{"_index":2,"t":{"19173":{"position":[[7,4],[65,3]]},"19181":{"position":[[0,3]]}}}],["packag",{"_index":10,"t":{"19173":{"position":[[99,8]]},"19181":{"position":[[95,8]]}}}],["parser",{"_index":7,"t":{"19173":{"position":[[53,7]]}}}],["py",{"_index":1,"t":{"19173":{"position":[[4,2]]},"19181":{"position":[[64,3]]}}}],["python",{"_index":9,"t":{"19173":{"position":[[92,6]]},"19181":{"position":[[17,6],[88,6]]}}}],["refer",{"_index":4,"t":{"19173":{"position":[[21,11]]}}}],["sdv",{"_index":0,"t":{"19173":{"position":[[0,3]]},"19181":{"position":[[60,3]]}}}],["sportsdatavers",{"_index":8,"t":{"19173":{"position":[[76,15]]},"19181":{"position":[[72,15]]}}}]],"pipeline":["stemmer"]}},{"documents":[],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[],"invertedIndex":[],"pipeline":["stemmer"]}},{"documents":[{"i":19178,"t":"mhl_season_id most_recent_mhl_season","s":"Dates and seasons","u":"/docs/mhl/","h":"#dates-and-seasons","p":19173},{"i":19180,"t":"Worked examples — executed notebooks rendered as pages (refreshed weekly against the live APIs): Quickstart","s":"Examples","u":"/docs/mhl/","h":"#examples","p":19173},{"i":19182,"t":"Hand-written wrappers, loaders, and helpers in sportsdataverse.hockey.mhl that are not generated API-endpoint wrappers (those have their own reference pages).","s":"MHL — additional Python functions","u":"/docs/mhl/reference/additional","h":"","p":19181},{"i":19185,"t":"build_family(league: 'str') -> 'dict[str, Any]' Return a dict of public callables for league. All callables are fully independent closures over the single league string; none share mutable state. The dict is ready to be spread into a module namespace via globals().update(...). Parameters Returns Keys are the public function names (e.g. \"ahl_schedule\").","s":"build_family","u":"/docs/mhl/reference/additional","h":"#build_family","p":19181},{"i":19187,"t":"mhl_game_corsi(game_id: 'int', return_as_pandas: 'bool' = False) -> 'Any' Player-level on-ice Corsi and Fenwick for a single MHL game. Parameters Returns One row per player on ice for a shot attempt: player_id (String), corsi_for / corsi_against / corsi_for_pct, fenwick_for / fenwick_against / fenwick_for_pct, corsi_includes_missed (Boolean), toi_seconds (Int64) and corsi_for_per60 (Float64, null without time on ice). A pandas DataFrame when return_as_pandas is True. Raises","s":"mhl_game_corsi","u":"/docs/mhl/reference/additional","h":"#mhl_game_corsi","p":19181},{"i":19189,"t":"mhl_game_shifts(game_id: 'int', return_as_pandas: 'bool' = False) -> 'Any' Parsed shift stints for a single MHL game. Parameters Returns One row per shift: game_id and player_id (Int64), first_name, last_name, jersey_number, home (Int64, 1 = home), period, start_time / end_time / length (clock strings), start_s / end_s (Int64 seconds) and the goal_on_shift / penalty_on_shift flags. A pandas DataFrame when return_as_pandas is True. Raises","s":"mhl_game_shifts","u":"/docs/mhl/reference/additional","h":"#mhl_game_shifts","p":19181},{"i":19191,"t":"mhl_game_summary(game_id: 'int') -> 'dict' MHL game summary — dict of frames (game/goals/penalties/shots_by_period/three_stars). Parameters Returns game (one row: game_id, date, status, venue, attendance, both teams and scores), goals (one row per goal with the scorer, both assists and the plus / minus skaters), penalties (one row per penalty), shots_by_period (side, period, shots) and three_stars. When the league denies the summary view, the event frames are empty and game is a game_id stub row. Raises","s":"mhl_game_summary","u":"/docs/mhl/reference/additional","h":"#mhl_game_summary","p":19181},{"i":19193,"t":"mhl_leaders(season: 'Optional[int]' = None, season_id: 'Optional[int]' = None, return_as_pandas: 'bool' = False) -> 'Any' MHL statistical leaders for a given season. Parameters Returns One row per ranked skater (points and goals leaders): rank (Int64), player_id, name, jersey_number, position, team_id / team_name / team_code, stat_formatted and type_formatted (String), plus photo and logo URLs. A pandas DataFrame when return_as_pandas is True. Raises","s":"mhl_leaders","u":"/docs/mhl/reference/additional","h":"#mhl_leaders","p":19181},{"i":19195,"t":"mhl_pbp(game_id: 'int', return_as_pandas: 'bool' = False) -> 'Any' MHL play-by-play — one row per event, fully enriched. Parameters Returns One row per event (shot, goal, penalty, faceoff, hit, goalie change ...): game_id, event, team_id, period_of_game, time_of_period, rink x_coord / y_coord (Float64, raw 600×300 coordinates), the primary / second / third player and goalie ids and names, the plus / minus skaters on a goal, game metadata from the game summary, and derived shot_distance / shot_angle / scoring_chance and the on_ice_home / on_ice_away skaters from the shift feed. Player ids are Float64 here. Some leagues (USHL, MJHL) publish only goals, penalties and goalie changes, with no coordinates. A pandas DataFrame when return_as_pandas is True. Raises","s":"mhl_pbp","u":"/docs/mhl/reference/additional","h":"#mhl_pbp","p":19181},{"i":19197,"t":"mhl_player_stats(player_id: 'int', return_as_pandas: 'bool' = False) -> 'Any' MHL player season stats across all seasons. Parameters Returns One row per season (and team) the player played: season_id, season_name, playoff, team_id / team_name / team_code, games_played, goals, assists, points, plus_minus, penalty_minutes, power-play / short-handed / shootout splits, shots, faceoff_wins / faceoff_attempts, ice_time and stat_type (String, as the feed ships them). A pandas DataFrame when return_as_pandas is True. Raises","s":"mhl_player_stats","u":"/docs/mhl/reference/additional","h":"#mhl_player_stats","p":19181},{"i":19199,"t":"mhl_player_toi(game_id: 'int', return_as_pandas: 'bool' = False) -> 'Any' Per-player time-on-ice totals for a single MHL game. Parameters Returns One row per player: player_id (Int64), first_name, last_name, toi_seconds (Int64), num_shifts and avg_shift_s (Float64). A pandas DataFrame when return_as_pandas is True. Raises","s":"mhl_player_toi","u":"/docs/mhl/reference/additional","h":"#mhl_player_toi","p":19181},{"i":19201,"t":"mhl_schedule(season: 'Optional[int]' = None, season_id: 'Optional[int]' = None, return_as_pandas: 'bool' = False) -> 'Any' MHL schedule — one row per game of one season. Parameters Returns One row per game: game_id, game_date, game_status, home_team / home_team_id / home_score, away_team / away_team_id / away_score, venue, season_id and game_type (all String). Only the requested season's games: a regular season, its playoffs and its preseason are separate season ids, so pass season_id (from mhl_season_id()) for the playoffs. A pandas DataFrame when return_as_pandas is True. Raises","s":"mhl_schedule","u":"/docs/mhl/reference/additional","h":"#mhl_schedule","p":19181},{"i":19203,"t":"mhl_standings(season: 'Optional[int]' = None, season_id: 'Optional[int]' = None, return_as_pandas: 'bool' = False) -> 'Any' MHL standings — one row per team. Parameters Returns One row per team: team, team_code, team_rank and wins (Int64), and games_played, losses, regulation_wins, non_reg_wins, non_reg_losses, points, goals_for, goals_against, games_remaining, percentage and overall_rank (String, as the feed ships them). A pandas DataFrame when return_as_pandas is True. Raises","s":"mhl_standings","u":"/docs/mhl/reference/additional","h":"#mhl_standings","p":19181},{"i":19205,"t":"mhl_team_roster(team_id: 'int', season: 'Optional[int]' = None, season_id: 'Optional[int]' = None, return_as_pandas: 'bool' = False) -> 'Any' MHL team roster for a given team + season. Parameters Returns One row per rostered player: player_id, person_id, names (first_name, last_name, display_name), position, tp_jersey_number, shoots / catches, height / weight, birthdate, home and birth places, rookie, veteran_status, draft_status and player_image (String, as the feed ships them). A pandas DataFrame when return_as_pandas is True. Raises","s":"mhl_team_roster","u":"/docs/mhl/reference/additional","h":"#mhl_team_roster","p":19181},{"i":19207,"t":"mhl_teams(season: 'Optional[int]' = None, season_id: 'Optional[int]' = None, return_as_pandas: 'bool' = False) -> 'Any' MHL teams for a given season. Parameters Returns One row per team: team_id, team_name, team_code, team_nickname, team_label, division and team_logo (String). A pandas DataFrame when return_as_pandas is True. Raises","s":"mhl_teams","u":"/docs/mhl/reference/additional","h":"#mhl_teams","p":19181},{"i":19210,"t":"mhl_season_id(return_as_pandas: 'bool' = False) -> 'Any' All MHL seasons with end-year + game-type labels. Parameters Returns One row per season: season_id (Int64), season_name, season_short, career, playoff, start_date, end_date, season_yr (Int64, the END year) and game_type_label. A pandas DataFrame when return_as_pandas is True. Raises","s":"mhl_season_id","u":"/docs/mhl/reference/additional","h":"#mhl_season_id","p":19181},{"i":19212,"t":"most_recent_mhl_season() -> 'int' Newest MHL regular season as an end-year integer: the highest season_yr of a regular season that is not a one-off event, so a preseason listed first is not a default. Returns The newest regular season's END year (2026 = the 2025-26 season). Raises","s":"most_recent_mhl_season","u":"/docs/mhl/reference/additional","h":"#most_recent_mhl_season","p":19181}],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[["t/19178",[0,3.237,1,3.237]],["t/19180",[2,3.483,3,3.483,4,0.21,5,3.483,6,3.483,7,3.483,8,2.767,9,3.483,10,3.483,11,3.483,12,3.483,13,2.767,14,3.483]],["t/19182",[8,2.767,13,2.767,15,2.767,16,3.483,17,4.255,18,3.483,19,3.483,20,3.483,21,3.483,22,3.483,23,3.483,24,3.483]],["t/19185",[4,0.161,25,2.671,26,2.671,27,2.671,28