":\"Duke\",\"Player1\":\"Caleb Foster\",\"Player2\":\"Tyrese Proctor\",\"Player3\":\"Kon Knueppel\",\"Player4\":\"Cooper Flagg\",\"Player5\":\"Maliq Brown\",\"PTRank\":10,\"PctPT\":2.29999999999999982236431605997495353221893310546875,\"Player1_data\":{\"playerID\":54329,\"Name\":\"Caleb Foster\",\"PctPoss\":20.780000000000001136868377216160297393798828125,\"FTA\":35,\"FG2A\":95,\"FG3A\":73,\"Height\":\"6-5\",\"Weight\":202,\"Year\":\"So\"},\"Player2_data\":{\"playerID\":52640,\"Name\":\"Tyrese Proctor\",\"PctPoss\":18.60000000000000142108547152020037174224853515625,\"FTA\":75,\"FG2A\":145,\"FG3A\":220,\"Height\":\"6-6\",\"Weight\":183,\"Year\":\"Jr\"},\"Player3_data\":{\"playerID\":56056,\"Name\":\"Kon Knueppel\",\"PctPoss\":20.839999999999999857891452847979962825775146484375,\"FTA\":128,\"FG2A\":171,\"FG3A\":207,\"Height\":\"6-7\",\"Weight\":217,\"Year\":\"Fr\"},\"Player4_data\":{\"playerID\":56054,\"Name\":\"Cooper Flagg\",\"PctPoss\":30.769999999999999573674358543939888477325439453125,\"FTA\":213,\"FG2A\":362,\"FG3A\":135,\"Height\":\"6-9\",\"Weight\":205,\"Year\":\"Fr\"},\"Player5_data\":{\"playerID\":53257,\"Name\":\"Maliq Brown\",\"PctPoss\":12.230000000000000426325641456060111522674560546875,\"FTA\":16,\"FG2A\":29,\"FG3A\":12,\"Height\":\"6-9\",\"Weight\":222,\"Year\":\"Jr\"}},{\"Season\":\"2025\",\"id\":1550,\"TeamName\":\"Duke\",\"Player1\":\"UNKNOWN\",\"Player2\":\"\",\"Player3\":\"\",\"Player4\":\"\",\"Player5\":\"\",\"PTRank\":21,\"PctPT\":1.1999999999999999555910790149937383830547332763671875,\"Player1_data\":null,\"Player2_data\":null,\"Player3_data\":null,\"Player4_data\":null,\"Player5_data\":null}];\nconst positions = ['PG', 'SG', 'SF', 'PF', 'C'];\nconst pctKeys   = ['PctPG', 'PctSG', 'PctSF', 'PctPF', 'PctC'];\n\nfunction shotRatio(p) {\n  const fg3a = parseFloat(p.FG3A) || 0;\n  const fg2a = parseFloat(p.FG2A) || 0;\n  const total = fg3a + fg2a;\n  return total > 0 ? fg3a / total : 0;\n}\n\nfunction getColors(ratio, dark) {\n    const t = Math.min(ratio / 0.75, 1);  // clamp to 1 at 0.75\n  if (dark) {\n    const bg = `rgb(\n      ${Math.round(16 + t * (30  - 16))},\n      ${Math.round(12 + t * (150 - 12))},\n      ${Math.round(8 + t * (30  - 8))}\n    )`;\n    return { bg};\n  } else {\n    const bg = `rgb(\n      ${Math.round(242  + t * (73  - 242))},\n      ${Math.round(250  + t * (253 - 250))},\n      ${Math.round(253  + t * (76  - 253))}\n    )`;\n    return { bg };\n  }\n}\n\nfunction buildDepthChart(dark) {\n  // Group players by position, sorted by pct descending\n  const cols = positions.map(() => []);\n  players.forEach(p => {\n    const ratio = shotRatio(p);\n    pctKeys.forEach((key, i) => {\n      const pct = parseFloat(p[key]) || 0;\n      if (pct > 4.50) {\n        cols[i].push({\n          id: p.playerID,\n          name:  p.Name,\n          pct,\n          ratio,\n          height: p.Height,\n          weight: p.Weight,\n          year:   p.Year,\n          pctposs: parseFloat(p.PctPoss) || 0\n        });\n      }\n    });\n  });\n  cols.forEach(c => c.sort((a, b) => b.pct - a.pct));\n  \n  const chart = document.getElementById('depth-chart');\n  chart.innerHTML = '';\n\n  positions.forEach((pos, i) => {\n    const col = document.createElement('div');\n    col.className = 'col';\n\n    const header = document.createElement('div');\n    header.className = 'col-header';\n    header.textContent = pos;\n    col.appendChild(header);\n\n    const body = document.createElement('div');\n    body.className = 'col-body';\n\n    cols[i].forEach((p, rank) => {\n      const c = getColors(p.ratio, dark);\n      const row = document.createElement('div');\n      row.className = 'player-row';\n        row.innerHTML = `\n        <div class=\"player-card\"\n            style=\"background:${c.bg}; \n            border-color:${p.pctposs < 12 ? '#ccc' : 'var(--border)'};\n            border-width:${getBorderWidth(p.pctposs)}px;\n            border-style:${getBorderStyle(p.pctposs)};\">\n            <div class=\"player-name\">\n            <a href=\"player.php?p=${p.id}\">${p.name}</a>\n            </div>\n            <div class=\"player-meta\" style=\"color:var(--text);\">\n            ${p.height} &nbsp; ${p.weight} &nbsp; ${p.year}\n            </div>\n        </div>\n        <div class=\"pct-label\">${Math.round(p.pct)}%</div>\n        `;\n      body.appendChild(row);\n    });\n\n    col.appendChild(body);\n    chart.appendChild(col);\n  });\n}\n\nfunction buildLineupChart(dark) {\n  const chart = document.getElementById('lineup-chart');\n  chart.innerHTML = '';\n\n  // header\n  const header = document.createElement('div');\n  header.className = 'lineup-header';\n  header.innerHTML = `\n    <div class=\"lineup-rank\"></div>\n    <div class=\"lineup-header-cards\">\n      ${positions.map(p => `\n        <div class=\"lineup-pos-label\" style=\"flex:1\">${p}</div>\n      `).join('')}\n    </div>\n    <div class=\"lineup-pct\">Pct</div>\n  `;\n  chart.appendChild(header);\n  lineups.forEach((lineup, idx) => {\n    const row = document.createElement('div');\n    row.className = 'lineup-row';\n\n    const cards = [1,2,3,4,5].map(i => {\n        const p = lineup[`Player${i}_data`];\n        const name = lineup[`Player${i}`];\n        // handle UNKNOWN or missing player\n        if (lineup['Player1'] === 'UNKNOWN' && i === 5 && lineup.PctPT>0) {\n            return `\n            <div style=\"flex:1; font-size:13px; color:var(--text);\n                        display:flex; align-items:center; justify-content:center; padding: 0 4px;\">\n                UNKNOWN\n            </div>\n            `;\n        }\n\n        // empty slot for slots 1-4 when lineup is UNKNOWN\n        if (lineup['Player1'] === 'UNKNOWN' && lineup.PctPT>0) return `<div style=\"flex:1\"></div>`;\n\n        const fg3a     = parseFloat(p.FG3A)    || 0;\n        const fg2a     = parseFloat(p.FG2A)    || 0;\n        const total    = fg3a + fg2a;\n        const ratio    = total > 0 ? fg3a / total : 0;\n        const pctposs  = parseFloat(p.PctPoss) || 0;\n        const c        = getColors(ratio, dark);\n\n        return `\n        <div class=\"player-card\"\n            style=\"flex:1;\n                background:${c.bg};\n                border-color:${pctposs < 12 ? '#ccc' : 'var(--border)'};\n                border-width:${getBorderWidth(pctposs)}px;\n                border-style:${getBorderStyle(pctposs)};\">\n            <div class=\"player-name\" style=\"color:${c.text};\">\n                <a href=\"/player.php?p=${p.playerID}\">${p.Name}</a>\n            </div>\n            <div class=\"player-meta\" style=\"color:${c.sub};\">\n                ${p.Height} &nbsp; ${p.Weight} &nbsp; ${p.Year}\n            </div>\n        </div>\n      `;\n    }).join('');\n\n    row.innerHTML = `\n      <div class=\"lineup-rank\">${idx < 10 ? idx + 1 : \"\"}</div>\n      <div class=\"lineup-cards\">${cards}</div>\n      <div class=\"lineup-pct\">${lineup.PctPT.toFixed(1)}</div>\n    `;\n\n    chart.appendChild(row);\n  });\n}\n\nfunction getBorderWidth(pctposs) {\n  if (pctposs >= 16) {\n    // scale 1px at 16% to 5px at 32%, clamped above 32\n    const t = Math.min((pctposs - 16) / (32 - 16), 1);\n    return (1 + t * (5 - 1)).toFixed(1);\n  }\n  return '1';\n}\n\nfunction getBorderStyle(pctposs) {\n  return pctposs >= 16 ? 'solid' : 'dotted';\n}\n\nif (season>=2010) {\n    buildDepthChart(isDark);\n    buildLineupChart(isDark);\n}\n\n</script>\n\n</div></div>\n<footer>\n© 1999-2026 The Forecast Factory LLC. All rights reserved.\n<span class=\"mobileHide\">| <a href=\"terms.php\">Terms of Use</a> | <a href=\"privacy.php\">Privacy Policy</a> | Stats provided by <a href=\"https://stats.com\">STATS Perform</a><br></span>\n</footer>\n\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a470ae14997e8abe',t:'MTc5MTQxNTY4Mw=='};var a=document.createElement('scri