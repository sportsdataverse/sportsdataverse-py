pl\":364,\"max_efg\":364};\nconst max_data_conf = {\"max_rtg\":18,\"max_apl\":18,\"max_efg\":18};\nconst season = \"2025\";\nconst current_season = 0;\n\n</script>\n\n<script type=\"text/javascript\">\nconst checkbox = document.getElementById('confselect');\n\nconst storedTheme = localStorage.getItem('theme');\n\nlet isDark = storedTheme\n    ? storedTheme === 'dark'\n    : window.matchMedia('(prefers-color-scheme: dark)').matches;\n\ndocument.documentElement.setAttribute(\n    'data-theme',\n    isDark ? 'dark' : 'light'\n);\n\ndocument.querySelectorAll('.theme-toggle').forEach(toggle => {\n    toggle.addEventListener('click', () => {\n        isDark = !isDark;\n\n        const newTheme = isDark ? 'dark' : 'light';\n\n        localStorage.setItem('theme', newTheme);\n        document.documentElement.setAttribute('data-theme', newTheme);\n\n        populateTable(checkbox.checked ? confData : allData,checkbox.checked,season);\n        if (season>=2010) {\n            buildDepthChart(isDark);\n            buildLineupChart(isDark);\n        }\n    });\n});\n\nfunction populateTable(data,isConf,season) {\n    // map each stat key to its destination URL\n    const statLinks = {\n        AdjOE: 'summary.php?s=RankAdjOE',\n        AdjDE: 'summary.php?s=RankAdjDE',\n        AdjTempo: 'summary.php?s=RankAdjTempo',\n        APL_Off: 'summary.php?s=RankAPL_Off',\n        APL_Def: 'summary.php?s=RankAPL_Def',\n        eFG_Pct: 'stats.php?s=RankeFG_Pct',\n        OppeFG_Pct: 'stats.php?s=RankDeFG_Pct',\n        TO_Pct: 'stats.php?s=RankTO_Pct',\n        OppTO_Pct: 'stats.php?s=RankDTO_Pct',\n        OR_Pct: 'stats.php?s=RankOR_Pct',\n        OppOR_Pct: 'stats.php?s=RankDOR_Pct',\n        FT_Rate: 'stats.php?s=RankFT_Rate',\n        OppFT_Rate: 'stats.php?s=RankDFT_Rate',\n        FG3Pct: 'teamstats.php?s=RankFG3Pct',\n        OppFG3Pct: 'teamstats.php?s=RankFG3Pct&od=d',\n        FG2Pct: 'teamstats.php?s=RankFG2Pct',\n        OppFG2Pct: 'teamstats.php?s=RankFG2Pct&od=d',\n        FTPct: 'teamstats.php?s=RankFTPct',\n        OppFTPct: 'teamstats.php?s=RankFTPct&od=d',\n        BlockPct: 'teamstats.php?s=RankBlockPct&od=d',\n        OppBlockPct: 'teamstats.php?s=RankBlockPct',\n        StlRate: 'teamstats.php?s=RankStlRate&od=d',\n        OppStlRate: 'teamstats.php?s=RankStlRate',\n        NSTRate: 'teamstats.php?s=RankNSTRate',\n        OppNSTRate: 'teamstats.php?s=RankNSTRate&od=d',\n        shotdist_off: 'teamstats.php?s=RankShotDist',\n        shotdist_def: 'teamstats.php?s=RankShotDist&od=d',\n        F3GRate: 'teamstats.php?s=RankF3GRate',\n        OppF3GRate: 'teamstats.php?s=RankF3GRate&od=d',\n        ARate: 'teamstats.php?s=RankARate',\n        OppARate: 'teamstats.php?s=RankARate&od=d',\n        Off_3: 'pointdist.php?s=RankOff_3',\n        Def_3: 'pointdist.php?s=RankDef_3',\n        Off_2: 'pointdist.php?s=RankOff_2',\n        Def_2: 'pointdist.php?s=RankDef_2',\n        Off_1: 'pointdist.php?s=RankOff_1',\n        Def_1: 'pointdist.php?s=RankDef_1'\n    };\n\n    document.querySelectorAll('.stat').forEach(cell => {\n        const key   = cell.dataset.key;\n        const rank  = cell.dataset.rank;\n        let raw    = data[key] ?? '';\n        const rankVal = rank ? data[rank] ?? '' : '';\n\n        const format = cell.dataset.format ?? 'decimal';\n        const effLabel = document.querySelector('[data-label=\"efficiency\"]');\n        const tempoLabel = document.querySelector('[data-label=\"tempo\"]');\n\n        const alt_shading = ['AdjTempo','APL_Off','APL_Def','F3GRate','OppF3GRate','ARate','OppARate'];\n        const no_shading = ['Off_3','Def_3','Off_1','Def_1','Off_2','Def_2'];\n\n        const max_rank_rtg_stats = ['AdjTempo','AdjOE','AdjDE'];\n        const max_rank_apl_stats = ['APL_Off','APL_Def'];\n        max_rank_rtg_stats.includes(key) ? max_rank = isConf ? max_data_conf['max_rtg'] : max_data['max_rtg'] : null;\n        max_rank_apl_stats.includes(key) ? max_rank = isConf ? max_data_conf['max_apl'] : max_data['max_apl'] : null;\n\n        color_scheme = alt_shading.includes(key) ? 'blue_orange' : 'red_green';\n\n        if (max_rank_rtg_stats.includes(key)) {\n            max_rank = isConf ? max_data_conf['max_rtg'] : max_data['max_rtg'];\n        } else if (max_rank_apl_stats.includes(key)) {\n            max_rank = isConf ? max_data_conf['max_apl'] : max_data['max_apl'];\n        } else {\n            max_rank = isConf ? max_data_conf['max_efg'] : max_data['max_efg'];\n        }\n        if (key === 'StlRate' || key === 'OppStlRate') {\n            raw = 100*raw;\n        }\n\n        let value;\n\n        if (format === 'decimal') value = raw !== '' ? parseFloat(raw).toFixed(1) : '';\n        else if (format === 'percent') value = raw !== '' ? parseFloat(raw).toFixed(1) + '%' : '';\n        else value = raw;\n\n        let link = statLinks[key] ?? '#';\n        if (current_season == 0 && link !== '#') {\n           link += `&y=${season}`;\n        }\n\n        cell.innerHTML = rankVal\n            ? `<a href='${link}'>${value}</a> <span class=\"seed-rank\">${rankVal}</span>`\n            : value;\n\n        if (effLabel) {\n            effLabel.textContent = isConf ? 'Raw Efficiency' : 'Adj. Efficiency';\n            tempoLabel.textContent = isConf ? 'Raw Tempo' : 'Adj. Tempo';\n          }\n\n        no_shading.includes(key) ? null : applyShade(cell, parseInt(rankVal), invert=false, max_teams=max_rank, color_scale=color_scheme);\n    });\n}\n\n// Load default on page load\npopulateTable(allData, 0, season);\n\nfunction populateDepthChart(data) {\n    document.querySelectorAll('.depth-stat').forEach(cell => {\n        const rank = cell.dataset.rank;\n        const rankVal = rank ? data[rank] ?? '' : '';\n\n        cell.innerHTML = rankVal ? `${rankVal}%` : '';\n\n        // Apply shading based on rank\n        applyShade(cell, parseInt(rankVal), true); // Invert for depth chart\n    });\n}\n\n// // Swap on toggle\ncheckbox.addEventListener('change', () => {\n    const isConf = checkbox.checked;\n    populateTable(isConf ? confData : allData, isConf, season);\n});\n\nfunction dechex(d) {return d.toString(16);}\n\n//where to add?\nconst colors_depthchart = isDark ? [\n    { stop: 0.0, r: 42,  g: 42,  b: 42  },  // dark bg (zero)\n    { stop: 1.0, r: 26,  g: 150, b: 65  },  // green\n] : [\n    { stop: 0.0, r: 242, g: 250, b: 253 },  // white  (zero)\n    { stop: 1.0, r: 0,  g: 255, b: 0  },  // green  (best)\n];\n\nfunction rankToColor(rank, invert = false, totalTeams = max_rank, color_scale='red_green') {\n    if (!rank || isNaN(rank)) return '';\n    const effectiveRank = invert ? (totalTeams - rank + 1) : rank;\n    // 0.0 = best (rank 1), 1.0 = worst (rank 364)\n    let pct = (effectiveRank - 1) / (totalTeams - 1);\n    if (pct<.5) {\n        pct = Math.pow(2*pct,.2)/2;\n    } else {\n        pct = 1 - Math.pow(2*(1 - pct), 0.2)/2;\n    }   \n\n    // Define your green -> white -> red spectrum\n    if (color_scale==='red_green') {\n\t\tvar colors = isDark ? [\n                { stop: 0.0, r: 26,  g: 205, b: 65  },  // green\n\t\t\t\t{ stop: 0.5, r: 42,  g: 42,  b: 42  },  // dark bg (average)\n\t\t\t\t{ stop: 1.0, r: 255, g: 0,   b: 0  },  // red\n\t\t\t] : [\n\t\t\t\t{ stop: 0.0, r: 0,  g: 255, b: 0  },  // green  (best)\n\t\t\t\t{ stop: 0.5, r: 242, g: 250, b: 253 },  // light bg  (average)\n\t\t\t\t{ stop: 1.0, r: 255, g: 65,   b: 65  },  // red    (worst)\n\t\t\t];\n    } else if (color_scale=='blue_orange') {\n\t\tvar colors = isDark ? [\n\t\t\t\t{ stop: 0.0, r: 255, g: 89,   b: 0  },  // orange    \n\t\t\t\t{ stop: 0.5, r: 42,  g: 42,  b: 42  },  // dark bg (average)\n\t\t\t\t{ stop: 1.0, r: 0,  g: 0, b: 255  },  // blue  \n\t\t\t] : [\n\t\t\t\t{ stop: 0.0, r: 255, g: 89,   b: 0  },  // orange    \n\t\t\t\t{ stop: 0.5, r: 242, g: 250, b: 253 },  // light bg  (average)\n\t\t\t\t{ stop: 1.0, r: 0,  g: 0, b: 255  },  // blue  \n\t\t\t];\n    }\n    // Find which two stops we're between\n    let lower = colors[0];\n    let upper = colors[colors.length - 1];\n    for (let i = 0; i < colors.length - 1; i++) {\n        if (pct >= colors[i].stop && pct <= colors[i + 1].stop) {\n            lower = colors[i];\n            upper = colors[i + 1];\n            break;\n        }\n    }\n\n    // Interpolate between the two stops\n    const range = upper.stop - lower.stop;\n    const t     = (pct - lower.stop) / range;\n\n    const r = Math.round(lower.r + t * (upper.r - lower.r));\n    const g = Math.round(lower.g + t * (upper.g - lower.g));\n    const b = Math.round(lower.b + t * (upper.b - lower.b));\n\n    return `rgb(${r}, ${g}, ${b})`;\n}\n\nfunction applyShade(cell, rank, invert = false, max_teams = max_rank, color_scale='red_green') {\n    const bg = rankToColor(rank, invert, max_teams, color_scale);\n    cell.style.backgroundColor = bg;\n    // Auto-flip text to white when background is dark\n    if (bg) {\n        const match = bg.match(/\\d+/g).map(Number);\n        const luminance = (0.299 * match[0] + 0.587 * match[1] + 0.114 * match[2]) / 255;\n        cell.style.color = luminance < 0.5 ? '#ffffff' : '#000000';\n    } else {\n        cell.style.color = '';\n    }\n}\n\n</script>\n\n<script>\nconst players = [{\"playerID\":51841,\"PctPG\":2.5,\"PctSG\":0,\"PctSF\":0,\"PctPF\":0,\"PctC\":0,\"Name\":\"Spencer Hubbard\",\"PctPoss\":25.690000000000001278976924368180334568023681640625,\"FTA\":0,\"FG2A\":6,\"FG3A\":5,\"Height\":\"5-8\",\"Weight\":157,\"Year\":\"Sr\"},{\"playerID\":45885,\"PctPG\":0,\"PctSG\":0,\"PctSF\":0,\"PctPF\":0,\"PctC\":3.399999999999999911182158029987476766109466552734375,\"Name\":\"Neal Begovich\",\"PctPoss\":11.78999999999999914734871708787977695465087890625,\"FTA\":0,\"FG2A\":2,\"FG3A\":3,\"Height\":\"6-9\",\"Weight\":230,\"Year\":\"Sr\"},{\"playerID\":49143,\"PctPG\":0,\"PctSG\":0,\"PctSF\":1.899999999999999911182158029987476766109466552734375,\"PctPF\":0.59999999999999997779553950749686919152736663818359375,\"PctC\":0,\"Name\":\"Cameron Sheffield\",\"PctPoss\":17